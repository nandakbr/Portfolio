<script>
(function () {
    function q(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); }
    // Generic "one pane visible per group" switcher
    function wire(rootSel, tabAttr, paneAttr, activeCls, showDisplay) {
        q(rootSel).forEach(function (root) {
            var tabs = q('[' + tabAttr + ']', root), panes = q('[' + paneAttr + ']', root);
            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    var key = t.getAttribute(tabAttr);
                    tabs.forEach(function (x) { x.classList.toggle(activeCls, x === t); });
                    panes.forEach(function (p) {
                        var on = p.getAttribute(paneAttr) === key;
                        p.hidden = !on;
                        if (showDisplay) p.style.display = on ? showDisplay : 'none';
                    });
                });
            });
        });
    }
    wire('[data-ptw-tabwidget]', 'data-ptw-tab', 'data-ptw-pane', 'is-active');
    wire('[data-ptw-loc]', 'data-ptw-loc-tab', 'data-ptw-loc-pane', 'is-active');
    wire('[data-ptw-prod]', 'data-ptw-prod-tab', 'data-ptw-prod-pane', 'is-active');
    wire('[data-ptw-hm]', 'data-ptw-hm-tab', 'data-ptw-hm-pane', 'is-active', 'flex');
    q('[data-ptw-kp-tabs]').forEach(function (g) {
        var tabs = q('.ptw-kp-tab', g);
        tabs.forEach(function (t) { t.addEventListener('click', function () { tabs.forEach(function (x) { x.classList.toggle('is-active', x === t); }); }); });
    });
    q('[data-ptw-acc]').forEach(function (a) {
        var h = a.querySelector('.ptw-acc-h'), ul = a.querySelector('ul');
        h.addEventListener('click', function () { var open = ul.hidden; ul.hidden = !open; a.classList.toggle('is-open', open); });
    });
})();
</script>
