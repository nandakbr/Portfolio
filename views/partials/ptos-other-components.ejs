    .ptw-hm-grid .dh { text-align: center; font-size: 9px; color: #64748b; line-height: 1.2; }
    .ptw-hm-grid .dh b { display: block; font-size: 11px; color: #0f2444; }
    .ptw-hm-grid .c { height: 40px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #0f2444; }
    .ptw-hm .low, .ptw-hm-sw.low { background: #e6f2fb; }
    .ptw-hm .norm, .ptw-hm-sw.norm { background: #b3d9f2; }
    .ptw-hm .busy, .ptw-hm-sw.busy { background: #66a9db; }
    .ptw-hm .warn, .ptw-hm-sw.warn { background: #1682c5; color: #fff !important; }
    .ptw-hm .crit, .ptw-hm-sw.crit { background: #ef4444; color: #fff !important; }
    .ptw-hm .over, .ptw-hm-sw.over { background: #fee2e2; border: 1px solid #ef4444; color: #b91c1c !important; }
    .ptw-hm .na, .ptw-hm-sw.na { background: #f8fafc; border: 1px dashed #94a3b8; color: #94a3b8 !important; }
    .ptw-hm-leg { display: flex; flex-wrap: wrap; gap: 14px; font-size: 11px; color: #64748b; }
    .ptw-hm-leg span { display: flex; align-items: center; gap: 5px; }
    .ptw-hm-sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
    .ptw-hm-foot { display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: #64748b; }
    .ptw-hm-foot div { display: flex; gap: 12px; }
    .ptw-hm-foot button { width: 28px; height: 28px; border-radius: 8px; border: 1px solid #dfe5ed; background: #fff; color: #64748b; font-size: 14px; cursor: not-allowed; opacity: .6; }

    /* Accordion */
    .ptw-acc { width: 896px; max-width: 100%; border: 1px solid #c8c5cb; border-radius: 10px; background: #fff; overflow: hidden; margin-bottom: 14px; }
    .ptw-acc-h { width: 100%; height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; background: #fff; border: 0; cursor: pointer; font-size: 16px; font-weight: 500; color: #292930; text-align: left; }
    .ptw-acc-h svg { color: #5d5e66; transition: transform 150ms ease; }
    .ptw-acc.is-open .ptw-acc-h svg { transform: rotate(180deg); }
    .ptw-acc ul { list-style: none; padding: 0 28px 16px; margin: 0; display: flex; flex-direction: column; gap: 16px; }
    .ptw-acc li { display: flex; gap: 8px; font-size: 16px; color: #47464b; line-height: 1.45; }
    .ptw-acc li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #292930; margin-top: 10px; flex-shrink: 0; }
</style>

<!-- ========== 1. Tab-Widget (Trend / Kinerja) ========== -->
