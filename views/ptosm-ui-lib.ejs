        .ptos-ui .ptos-pf-wtitle { flex: 1; min-width: 0; text-align: center; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #20211F; opacity: .5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ptos-pf-pad { padding: 28px 16px; background: #F9FAFC; }
        /* ---- Narrow windows (phones). Container queries follow the WINDOW width, not the screen,
           so the same rules also protect any other narrow host. The window is overflow:hidden, so anything wider
           than it is silently cropped - these rules make every specimen fit or scroll with a visible cue. ---- */
        .ptos-pf-window { container-type: inline-size; container-name: ptw; }
        @container ptw (max-width: 800px) {
            .ptos-tn { min-width: 0; height: auto; flex-wrap: wrap; row-gap: 12px; }
            .ptos-tn-left { flex: 1 1 100%; }
