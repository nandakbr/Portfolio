                                    <button type="button">3</button>
                                    <button type="button">4</button>
                                    <button type="button">5</button>
                                    <button type="button" aria-label="Next page">›</button>
                                </div>
                            </div>
                        </div>

                        <div class="p-5 rounded-xl" style="background:#0F2444">
                            <p class="text-xs font-semibold mb-3" style="color:rgba(255,255,255,0.5)">Dark theme</p>
                            <div class="ptos-table-footer ptos-pagination-dark-footer" style="margin-top:0">
                                <span class="ptos-item-display" style="color:rgba(255,255,255,0.5)">Showing 1-10 of 50 entries</span>
                                <div class="ptos-pagination ptos-pagination-dark" data-ptos-pagination>
                                    <button type="button" aria-label="Previous page">‹</button>
                                    <button type="button" class="is-active">1</button>
                                    <button type="button">2</button>
                                    <button type="button">3</button>
                                    <button type="button">4</button>
                                    <button type="button">5</button>
                                    <button type="button" aria-label="Next page">›</button>
                                </div>
                            </div>
                        </div>
                    </div></div>
                </section>

                <!-- ============================================= -->
                <!-- 10 — ICON SET                                  -->
                <!-- ============================================= -->
                <section id="ui-10" class="ptos-ui-chapter">
                    <div class="ptos-pf-head"><p class="ptos-pf-eyebrow">10 &mdash; Icon Set</p><h2 class="ptos-pf-h2">Icon Set</h2></div>
                    <p class="ptos-ui-note mb-6 max-w-2xl">
                        118 icons across 6 categories, 1:1 from Figma's Icon component instances — maritime &amp;
                        logistics, general UI, system, media, documents &amp; files, and communication &amp; commerce.
                    </p>

                    <div class="ptos-pf-window"><div class="ptos-pf-titlebar"><span class="ptos-pf-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ptos-pf-wtitle">icon-set.svg</span></div><div class="ptos-pf-pad"><div class="flex flex-col gap-8">
                        <div class="ptos-acc-bar" data-acc-bar>
                            <span class="ptos-acc-sum" data-acc-sum aria-live="polite"></span>
                            <button type="button" class="ptos-acc-all" data-acc-all>Expand all</button>
                        </div>
                        <% [
                            ['Maritime & Logistics', ['ship','anchor','container','construction','truck','forklift','warehouse','dock','compass','life-buoy','waves','ship-wheel','ticket','scale','weight','route','boxes','package']],
                            ['General UI', ['home','search','settings','user','users','bell','mail','calendar','clock','bookmark','tag','heart','star','thumbs-up','flag','plus','minus','menu','move','layers','hash','zap','refresh-cw','external-link','link','filter','arrow-up-down','eye','eye-off','check-circle','x-circle','alert-triangle','info','map-pin']],
                            ['System', ['wifi','bluetooth','monitor','smartphone','power','battery','cpu','database','server','cloud','terminal','code','globe','lock','unlock','shield','key','log-out']],
                            ['Media', ['play','pause','volume-2','mic','camera','image','music','headphones','video']],
                            ['Documents & Files', ['save','printer','download','upload','share-2','edit','trash-2','copy','clipboard','folder','folder-open','file','file-text','archive','paperclip','scissors','clipboard-check','receipt','barcode','qr-code']],
                            ['Communication & Commerce', ['message-square','phone','at-sign','send','credit-card','receipt','bar-chart','timer','calendar-check','wrench','hammer','arrow-up','arrow-down','arrow-left','arrow-right','chevron-right','chevron-down','maximize','minimize']]
                        ].forEach(function (group, gi) { %>
                        <div class="ptos-acc is-open" data-acc>
                            <button type="button" class="ptos-acc-head" id="acc-h-<%= gi %>" aria-expanded="true" aria-controls="acc-b-<%= gi %>">
                                <span class="ptos-acc-num" aria-hidden="true"><%= ('0' + (gi + 1)).slice(-2) %></span>
                                <span class="ptos-acc-title"><%= group[0] %></span>
                                <span class="ptos-acc-count" aria-label="<%= group[1].length %> icons"><%= group[1].length %></span>
                                <span class="ptos-acc-chev" aria-hidden="true"><i data-lucide="plus" style="width:20px;height:20px"></i></span>
                            </button>
                            <div class="ptos-acc-body" id="acc-b-<%= gi %>" role="region" aria-labelledby="acc-h-<%= gi %>"><div class="ptos-acc-inner">
                            <div class="ptos-icon-grid">
                                <% group[1].forEach(function (icon, ii) { %>
                                <div class="ptos-icon-cell" style="--i:<%= ii %>">
                                    <i data-lucide="<%= icon %>" style="width:20px;height:20px;color:var(--navy-700)"></i>
                                    <span><%= icon %></span>
                                </div>
                                <% }) %>
                            </div>
                            </div></div>
                        </div>
                        <% }) %>
                    </div></div></div>
                </section>

                <%- include('partials/more-projects', { current: '/ptosm-ui-lib', scope: 'u' }) %>

                <!-- ============================================= -->
                <!-- 11 — OTHER COMPONENTS (specimens only)         -->
                <!-- ============================================= -->


            </div>
        </div>
    </main>

    <script src="https://unpkg.com/lucide@1.72.0/dist/umd/lucide.min.js" integrity="sha384-LJKEYnLhvei+XTxKjLahwKnS/kWFWfkb3n+v8n7YKWAAS3oamYHQyT4Bwch3XplL" crossorigin="anonymous"></script>
    <script>
        if (window.lucide) { lucide.createIcons(); }
        if (window.__ptl) window.__ptl.icons();   // icons are drawn (or the CDN failed - the page still works, just without glyphs)

        // Sidebar: collapse toggle
        document.querySelectorAll('[data-sb-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const sb = btn.closest('.ptos-sb');
                if (sb) {
                    sb.classList.toggle('is-collapsed');
                    sb.querySelectorAll('.ptos-sb-item.has-flyout-open').forEach(function (i) {
                        i.classList.remove('has-flyout-open');
                        i.querySelector('.ptos-sb-flyout').classList.add('hidden');
                    });
                }
            });
        });

        // Collapsed-rail popups are position:fixed (the rail clips overflow), so place them from the icon's rect.
        function ptosPlace(el, item) {
            var r = item.getBoundingClientRect();
            el.style.left = (r.right + 10) + 'px';
            el.style.top = Math.max(8, Math.min(r.top + r.height / 2 - el.offsetHeight / 2, window.innerHeight - el.offsetHeight - 8)) + 'px';
        }
        function ptosCloseFlyouts() {
            document.querySelectorAll('.ptos-sb-item.has-flyout-open').forEach(function (i) {
                i.classList.remove('has-flyout-open');
                var f = i.querySelector('.ptos-sb-flyout'); if (f) f.classList.add('hidden');
            });
        }
        document.querySelectorAll('.ptos-sb [data-sb-item]').forEach(function (item) {
            var tip = item.querySelector('.ptos-sb-tooltip');
            item.addEventListener('mouseenter', function () {
                if (tip && item.closest('.ptos-sb').classList.contains('is-collapsed')) ptosPlace(tip, item);
            });
        });
        window.addEventListener('scroll', ptosCloseFlyouts, true);
        window.addEventListener('resize', ptosCloseFlyouts);

        // Sidebar: active module + inline sub-items (one open at a time,
        // clicking the already-active item closes it back) — expanded rail only.
        // Collapsed rail: hover shows the tooltip (pure CSS); clicking an item
        // with sub-items opens a flyout popover instead, closing any other
        // open flyout first (same "only one open at a time" rule as expanded).
        document.querySelectorAll('[data-ptos-sb-list]').forEach(function (list) {
            const sb = list.closest('.ptos-sb');
            const items = list.querySelectorAll('[data-sb-item]');
            items.forEach(function (item) {
                const flyout = item.querySelector('.ptos-sb-flyout');
                item.addEventListener('click', function (e) {
                    if (sb.classList.contains('is-collapsed')) {
                        if (!flyout) return;
                        e.stopPropagation();
                        const opening = flyout.classList.contains('hidden');
                        items.forEach(function (i) {
                            i.classList.remove('has-flyout-open');
                            const f = i.querySelector('.ptos-sb-flyout');
                            if (f) f.classList.add('hidden');
                        });
                        if (opening) {
                            flyout.classList.remove('hidden');
                            ptosPlace(flyout, item);
                            item.classList.add('has-flyout-open');
                        }
                        return;
                    }
                    const wasActive = item.classList.contains('is-active');
                    items.forEach(function (i) { i.classList.remove('is-active'); });
                    if (!wasActive) item.classList.add('is-active');
                });
                if (flyout) {
                    flyout.addEventListener('click', function (e) { e.stopPropagation(); });
                    flyout.querySelectorAll('.ptos-sb-flyout-item').forEach(function (fi) {
                        fi.addEventListener('click', function (e) {
                            e.stopPropagation();
                            flyout.classList.add('hidden');
                            item.classList.remove('has-flyout-open');
                        });
                    });
                }
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.ptos-sb-item.has-flyout-open').forEach(function (i) {
                i.classList.remove('has-flyout-open');
                i.querySelector('.ptos-sb-flyout').classList.add('hidden');
            });
        });

        // Dropdown: real open/close, click-outside-to-close
        document.querySelectorAll('[data-ptos-dropdown]').forEach(function (wrap) {
            const trigger = wrap.querySelector('.ptos-dropdown-trigger');
            const menu = wrap.querySelector('.ptos-dropdown-menu');
            if (!trigger || !menu) return;
            const close = function () { trigger.setAttribute('aria-expanded', 'false'); menu.classList.add('hidden'); };
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = trigger.getAttribute('aria-expanded') === 'true';
                document.querySelectorAll('.ptos-dropdown-trigger[aria-expanded="true"]').forEach(function (t) {
                    t.setAttribute('aria-expanded', 'false');
                    t.closest('[data-ptos-dropdown]').querySelector('.ptos-dropdown-menu').classList.add('hidden');
                });
                trigger.setAttribute('aria-expanded', open ? 'false' : 'true');
                menu.classList.toggle('hidden', open);
            });
            menu.querySelectorAll('.ptos-dropdown-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    trigger.querySelector('.label').textContent = item.textContent;
                    close();
                });
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.ptos-dropdown-trigger[aria-expanded="true"]').forEach(function (t) {
                t.setAttribute('aria-expanded', 'false');
                t.closest('[data-ptos-dropdown]').querySelector('.ptos-dropdown-menu').classList.add('hidden');
            });
        });

        // Tab bar / pill tab: real switching, one active per group
        document.querySelectorAll('[data-ptos-tabs]').forEach(function (group) {
            const tabs = group.querySelectorAll('[data-ptos-tab]');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
                    tab.classList.add('is-active');
                    tab.setAttribute('aria-selected', 'true');
                    const meta = group.parentElement.querySelector('[data-ptos-meta]');
                    if (meta) meta.textContent = meta.dataset.ptosMeta + ' Options · Active: ' + tab.textContent.trim();
                });
            });
        });

        // Single pill: real hover via CSS, click toggles Active
        document.querySelectorAll('[data-ptos-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const on = btn.classList.toggle('is-active');
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
        });

        // Section scroll-spy: highlights the current section in the side nav (lg+) and in the jump bar (below lg)
        (function () {
            const links = Array.from(document.querySelectorAll('.ptos-ui-chapter-nav a, .ptos-pf-jump a'));
            const secs = Array.from(document.querySelectorAll('.ptos-ui-chapter'));
            if (!links.length || !secs.length || !('IntersectionObserver' in window)) return;
            const mark = function (id) {
                links.forEach(function (a) {
                    const on = a.getAttribute('href') === '#' + id;
                    a.classList.toggle('is-active', on);
                    if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
                });
                const bar = document.querySelector('.ptos-pf-jump');
                const cur = bar && bar.querySelector('a.is-active');
                if (cur && bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: cur.offsetLeft - 24, behavior: 'smooth' });
            };
            const io = new IntersectionObserver(function (entries) {
                const vis = entries.filter(function (e) { return e.isIntersecting; })
                    .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
                if (vis.length) mark(vis[0].target.id);
            }, { rootMargin: '-20% 0px -65% 0px' });
            secs.forEach(function (s) { io.observe(s); });
            mark(secs[0].id);
        })();

        // Tab bars: fade the edge that still has hidden tabs (set --fl / --fr)
        (function () {
            const bars = Array.from(document.querySelectorAll('.ptos-tabbar'));
            const upd = function (b) {
                const left = b.scrollLeft > 1, right = b.scrollLeft + b.clientWidth < b.scrollWidth - 1;
                b.style.setProperty('--fl', left ? '40px' : '0px');
                b.style.setProperty('--fr', right ? '40px' : '0px');
            };
            bars.forEach(function (b) { b.addEventListener('scroll', function () { upd(b); }, { passive: true }); upd(b); });
            window.addEventListener('resize', function () { bars.forEach(upd); });
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { bars.forEach(upd); });
        })();

        // Icon Set accordion: <= 640px collapsible (first open), wider = always open and the header is inert
        (function () {
            const accs = Array.from(document.querySelectorAll('[data-acc]'));
            if (!accs.length) return;
            const mq = window.matchMedia('(max-width: 640px)');
            const allBtn = document.querySelector('[data-acc-all]');
            const sum = document.querySelector('[data-acc-sum]');
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
            const heads = accs.map(function (a) { return a.querySelector('.ptos-acc-head'); });
            const set = function (acc, open, animate) {
                const was = acc.classList.contains('is-open');
                acc.classList.toggle('is-open', open);
                acc.querySelector('.ptos-acc-head').setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open && !was && animate && !reduce.matches) {
                    acc.classList.add('is-opening');
                    clearTimeout(acc._t);
                    acc._t = setTimeout(function () { acc.classList.remove('is-opening'); }, 900);
                }
            };
            const refresh = function () {
                const open = accs.filter(function (a) { return a.classList.contains('is-open'); }).length;
                if (sum) sum.textContent = open + ' of ' + accs.length + ' categories open';
                if (allBtn) allBtn.textContent = open === accs.length ? 'Collapse all' : 'Expand all';
            };
            const layout = function () {
                accs.forEach(function (a, i) { set(a, mq.matches ? i === 0 : true, false); });
                heads.forEach(function (h) { h.tabIndex = mq.matches ? 0 : -1; });
                refresh();
            };
            heads.forEach(function (h, i) {
                h.addEventListener('click', function () {
                    if (!mq.matches) return;
                    set(accs[i], !accs[i].classList.contains('is-open'), true);
                    refresh();
                });
            });
            if (allBtn) allBtn.addEventListener('click', function () {
                const openAll = accs.some(function (a) { return !a.classList.contains('is-open'); });
                accs.forEach(function (a, i) { setTimeout(function () { set(a, openAll, true); refresh(); }, reduce.matches ? 0 : i * 60); });
            });
            if (mq.addEventListener) mq.addEventListener('change', layout); else mq.addListener(layout);
            layout();
        })();

        // Foundations: click a swatch to copy its hex
        (function () {
            const toast = document.getElementById('ptos-fd-toast');
            let timer;
            document.querySelectorAll('[data-ptos-copy]').forEach(function (sw) {
                sw.addEventListener('click', function () {
                    const hex = sw.getAttribute('data-ptos-copy');
                    const done = function (ok) {
                        if (!toast) return;
                        toast.textContent = ok ? 'Copied ' + hex : 'Could not copy ' + hex + ' (clipboard blocked)';
                        toast.classList.add('is-on');
                        sw.classList.toggle('is-copied', ok);
                        clearTimeout(timer);
                        timer = setTimeout(function () { toast.classList.remove('is-on'); sw.classList.remove('is-copied'); }, 1400);
                    };
                    // execCommand fallback: the async Clipboard API can be refused (permissions policy, insecure context)
                    const legacy = function () {
                        const ta = document.createElement('textarea');
                        ta.value = hex; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
                        document.body.appendChild(ta); ta.select();
                        let ok = false;
                        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                        document.body.removeChild(ta);
                        done(ok);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(hex).then(function () { done(true); }, legacy);
                    } else { legacy(); }
                });
            });
        })();

        // Card: click to select (skip disabled cards)
        document.querySelectorAll('[data-ptos-card]').forEach(function (card) {
            card.addEventListener('click', function () {
                if (card.classList.contains('is-disabled')) return;
                card.classList.toggle('is-selected');
            });
        });

        // Password visibility toggle (real)
        document.querySelectorAll('[data-ptos-password-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const input = btn.closest('.ptos-input-wrap').querySelector('[data-ptos-password-input]');
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.innerHTML = isPassword ? '<i data-lucide="eye-off"></i>' : '<i data-lucide="eye"></i>';
                if (window.lucide) window.lucide.createIcons();
            });
        });

        // Date Picker: real open/close/select, click-outside-to-close
        document.querySelectorAll('[data-ptos-datepicker]').forEach(function (wrap) {
            const trigger = wrap.querySelector('[data-ptos-dp-trigger]');
            const panel = wrap.querySelector('.ptos-datepicker-panel');
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                const opening = panel.classList.contains('hidden');
                document.querySelectorAll('.ptos-datepicker-panel').forEach(function (p) { p.classList.add('hidden'); });
                if (opening) panel.classList.remove('hidden');
            });
            panel.querySelectorAll('.ptos-dp-day').forEach(function (day) {
                day.addEventListener('click', function () {
                    panel.querySelectorAll('.ptos-dp-day').forEach(function (d) { d.classList.remove('is-selected'); });
                    day.classList.add('is-selected');
                    trigger.value = day.textContent.padStart(2, '0') + '/10/2026';
                    panel.classList.add('hidden');
                });
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.ptos-datepicker-panel').forEach(function (p) { p.classList.add('hidden'); });
        });

        // Action Menu (kebab popover): real open/close, click-outside-to-close
        document.querySelectorAll('[data-ptos-action-menu-wrap]').forEach(function (wrap) {
            const trigger = wrap.querySelector('[data-ptos-action-menu-trigger]');
            const menu = wrap.querySelector('.ptos-action-menu');
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                const opening = menu.classList.contains('hidden');
                document.querySelectorAll('.ptos-action-menu').forEach(function (m) { m.classList.add('hidden'); });
                document.querySelectorAll('[data-ptos-action-menu-trigger]').forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
                if (opening) {
                    menu.classList.remove('hidden');
                    trigger.setAttribute('aria-expanded', 'true');
                }
            });
            menu.querySelectorAll('.ptos-action-menu-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    menu.classList.add('hidden');
                    trigger.setAttribute('aria-expanded', 'false');
                });
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.ptos-action-menu').forEach(function (m) { m.classList.add('hidden'); });
            document.querySelectorAll('[data-ptos-action-menu-trigger]').forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
        });

        // Pagination: real page switching (numbered buttons + prev/next)
        document.querySelectorAll('[data-ptos-pagination]').forEach(function (nav) {
            const buttons = Array.from(nav.querySelectorAll('button'));
            const pageButtons = buttons.filter(function (b) { return /^\d+$/.test(b.textContent.trim()); });
            function setActive(btn) {
                pageButtons.forEach(function (b) { b.classList.remove('is-active'); });
                btn.classList.add('is-active');
            }
            pageButtons.forEach(function (btn) {
                btn.addEventListener('click', function () { setActive(btn); });
            });
            const prevBtn = buttons.find(function (b) { return b.getAttribute('aria-label') === 'Previous page'; });
            const nextBtn = buttons.find(function (b) { return b.getAttribute('aria-label') === 'Next page'; });
            if (prevBtn) prevBtn.addEventListener('click', function () {
                const idx = pageButtons.findIndex(function (b) { return b.classList.contains('is-active'); });
                if (idx > 0) setActive(pageButtons[idx - 1]);
            });
            if (nextBtn) nextBtn.addEventListener('click', function () {
                const idx = pageButtons.findIndex(function (b) { return b.classList.contains('is-active'); });
                if (idx < pageButtons.length - 1) setActive(pageButtons[idx + 1]);
            });
        });

        // Scroll-spy for the sticky chapter nav
        (function () {
            const links = document.querySelectorAll('.ptos-ui-chapter-nav a');
            if (!links.length) return;
            const sections = Array.from(links).map(function (l) { return document.querySelector(l.getAttribute('href')); }).filter(Boolean);
            const io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    links.forEach(function (l) { l.classList.remove('is-active'); });
                    const match = document.querySelector('.ptos-ui-chapter-nav a[href="#' + entry.target.id + '"]');
                    if (match) match.classList.add('is-active');
                });
            }, { rootMargin: '-20% 0px -70% 0px' });
            sections.forEach(function (s) { io.observe(s); });
        })();
    </script>
</body>

</html>
