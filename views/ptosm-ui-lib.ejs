        .ptos-pf-window { border: 1px solid rgba(0,0,0,.1); border-radius: 8px; overflow: hidden; background: #FAF9F4; box-shadow: 0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -2px rgba(0,0,0,.1); } /* = homepage rounded-lg shadow-md */
        .ptos-pf-window + .ptos-pf-window { margin-top: 24px; }
        .ptos-pf-titlebar { display: flex; align-items: center; gap: 14px; padding: 0 14px; height: 34px; background: #F2F0E8; } /* = homepage: h-[34px] px-3.5 gap-3.5 bg-background-light, no bottom border */
