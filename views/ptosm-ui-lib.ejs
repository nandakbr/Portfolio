        }
        /* scroll cue: the tab bar scrolls sideways on narrow windows; fade the edge that still has content */
        .ptos-tabbar { --fl: 0px; --fr: 0px; -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%); mask-image: linear-gradient(to right, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%); }

        .ptos-pf-window .ptos-ui-stage { border: 0; border-radius: 0; padding-inline: 16px; } /* 24 -> 16: frees 16px so 4 sidebars (819) and the 6-tab bar (715) fit the 847px column unscrolled */

        .ptos-ui-chapter-nav a { display: block; padding: 6px 0 6px 12px; border-left: 1px solid #CDCEC4; border-radius: 0; font-size: 12px; color: #77796F; background: none; transition: color 120ms ease, border-color 120ms ease; }
        .ptos-ui-chapter-nav a:hover, .ptos-ui-chapter-nav a.is-active { background: none; color: #20211F; font-weight: 500; border-left-color: #244BFF; }
        /* content column = main - side nav - gap. 160 + 32 keeps it >= 943px in the 1150px index window,
           which fits the widest specimens (4 sidebars = 819, 2 pill matrices = 788) with no horizontal scroll */
        .ptos-pf-layout { display: flex; gap: 32px; }
