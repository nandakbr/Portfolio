            .ptos-tn-right { flex: 1 1 100%; flex-shrink: 1; min-width: 0; }
            .ptos-tn-badge { flex: 1 1 auto; min-width: 0; white-space: normal; }
        }
        @container ptw (max-width: 420px) {
            .ptos-ui-stage { padding-inline: 12px !important; }
