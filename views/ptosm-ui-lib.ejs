        @media (min-width: 1024px) { .ptos-pf-aside { display: block; } }
        .ptos-pf-jump { position: sticky; top: 0; z-index: 30; display: flex; gap: 6px; overflow-x: auto; margin: 0 -24px 24px; padding: 10px 24px; background: rgba(242,240,232,.92); backdrop-filter: blur(6px); border-bottom: 1px solid rgba(0,0,0,.1); scrollbar-width: none; }
        .ptos-pf-jump::-webkit-scrollbar { display: none; }
