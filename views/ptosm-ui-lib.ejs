            .ptos-tabs-panel-meta { white-space: normal; }
            .ptos-pill-matrix { grid-template-columns: auto repeat(2, max-content); column-gap: 8px; padding: 16px 12px; }
        }

        @container ptw (max-width: 520px) {
            .ptos-fd-block { padding: 20px 16px; gap: 20px; }
            .ptos-fd-swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
            .ptos-fd-chips { flex-wrap: wrap; }
            .ptos-fd-chips .ptos-fd-swatch { flex: 0 0 calc((100% - 24px) / 4); }
            .ptos-fd-row2 { grid-template-columns: minmax(0, 1fr) !important; gap: 20px; }
            .ptos-fd-type { grid-template-columns: minmax(0, 1fr); gap: 2px; }
            .ptos-fd-type .s { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
            .ptos-fd-elev { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .ptos-fd-strokes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
            .ptos-fd-weights { gap: 20px; }
            .ptos-fd-space .r { grid-template-columns: 84px 36px minmax(0, 1fr); }
        }
        @media (max-width: 480px) {
            main.ptos-ui { padding-inline: 16px; }
