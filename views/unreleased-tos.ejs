<!DOCTYPE html>
<html class="scroll-smooth" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta property="og:title" content="Nanda Akbar | Unreleased Terminal Operating System" />
    <meta property="og:description" content="Next-generation terminal operating system currently in development." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nandakbr.com/unreleased-tos" />
    <meta property="og:image" content="/assets/Profile.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nanda Akbar | Unreleased Terminal Operating System" />
    <meta name="twitter:description" content="Next-generation terminal operating system currently in development." />
    <meta name="twitter:image" content="/assets/Profile.webp" />
    <title>Nanda Akbar | Unreleased Terminal Operating System</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Tinos:ital@1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/output.css" />
</head>

<body>
    <!-- Mobile only: redesigned to match desktop's macOS-window identity + the
         Figma "detail page" spec (header/nav/title/hero-carousel/gallery). Desktop
         still opens this page inside the draggable iframe window — unchanged. -->
    <div class="md:hidden">
        <!-- Header -->
        <div class="px-6 pt-5 pb-3">
            <div class="flex items-center justify-between">
                <a href="/" class="text-sm font-bold tracking-tight focus-ring">Nanda Akbar</a>
                <p class="text-[0.6rem] uppercase tracking-[0.15em] opacity-50">PORTFOLIO / WORK</p>
            </div>
            <div class="border-t border-black/10 mt-3"></div>
        </div>

        <!-- Nav row: back + category tag -->
        <div class="px-6 pb-4 flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5 text-sm opacity-70 active:opacity-40 focus-ring" aria-label="Back to index">
                <span class="material-symbols-outlined text-base">arrow_back</span>Index
            </a>
            <span class="text-[0.6rem] uppercase tracking-[0.1em] text-[#244BFF]">UI/UX DESIGN</span>
        </div>

        <!-- Title + description -->
        <div class="px-6 pb-6">
            <h1 class="text-3xl font-semibold leading-[1.05] tracking-tight">Unreleased Terminal Operating System</h1>
            <p class="text-sm opacity-60 leading-snug mt-3">A behind-the-scenes look at an unreleased terminal operating system, focused on streamlining operational planning and vessel entry workflows for port operators.</p>
        </div>

        <!-- Hero carousel: window-chrome, matches desktop/folder-window identity -->
        <div id="mobile-hero-wrap" class="px-6">
            <div class="rounded-lg border border-black/10 shadow-sm overflow-hidden bg-surface-window">
                <div class="flex items-center gap-[9px] px-[11px] h-[27px] bg-surface-titlebar-alt border-b border-black/10">
                    <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                    <span class="flex-1 text-center text-[0.65rem] opacity-50">Unreleased TOS</span>
                </div>
                <div class="aspect-[4/3] bg-background-light">
                    <img id="mobile-hero-image" alt="" class="w-full h-full object-cover" src="/assets/Ops Plan Detail 1.webp" loading="lazy" decoding="async">
                </div>
            </div>

            <!-- Carousel controls: prev/dots/next -->
            <div class="flex items-center justify-center gap-4 mt-4">
                <button type="button" onclick="mobileCarouselStep(-1)" aria-label="Previous"
                    class="w-8 h-8 rounded-full border border-black/10 flex items-center justify-center active:scale-90 transition-transform focus-ring">
                    <span class="material-symbols-outlined text-base opacity-60">chevron_left</span>
                </button>
                <div id="mobile-carousel-dots" class="flex items-center gap-1.5"></div>
                <button type="button" onclick="mobileCarouselStep(1)" aria-label="Next"
                    class="w-8 h-8 rounded-full border border-black/10 flex items-center justify-center active:scale-90 transition-transform focus-ring">
                    <span class="material-symbols-outlined text-base opacity-60">chevron_right</span>
                </button>
            </div>

            <!-- Expand button -->
            <button type="button" onclick="openLightbox(mobileCarouselIndex)"
                class="w-full mt-4 py-2.5 rounded-full border border-black/10 text-xs text-[#244BFF] flex items-center justify-center gap-1.5 active:scale-[0.98] transition-transform focus-ring">
                <span class="material-symbols-outlined text-sm">open_in_full</span>EXPAND
            </button>
        </div>

        <!-- Gallery: caption grid, same source data as the carousel -->
        <div class="px-6 pt-10 pb-10">
            <div class="flex items-baseline justify-between mb-4">
                <p class="text-xl font-semibold tracking-tight">Gallery</p>
                <p class="text-[0.6rem] uppercase tracking-[0.1em] text-[#244BFF]" id="mobile-gallery-count">04 VIEWS</p>
            </div>
            <div id="mobile-gallery-grid" class="grid grid-cols-2 gap-3"></div>
        </div>
    </div>

    <main class="hidden md:block max-w-7xl mx-auto px-6 md:px-12 pt-8 md:pt-16 pb-32">
        <!-- Project detail: metadata row + title + summary + hero (prev/next) + gallery
             — Figma "Unreleased TOS window" / "Project detail" frame, 1:1 content mapping. -->
        <div class="reveal-item">
            <div class="flex items-center justify-between mb-5">
                <p class="text-[0.65rem] font-black uppercase tracking-[0.2em] text-[#244BFF]">UI/UX Design</p>
                <button type="button" onclick="openLightbox(currentIndex)" class="flex items-center gap-1.5 text-xs opacity-50 hover:opacity-100 active:opacity-40 transition-opacity focus-ring cursor-pointer">
                    <span class="material-symbols-outlined text-base">open_in_full</span>Expand Image
                </button>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-5">
                Unreleased Terminal Operating System
            </h1>
            <p class="text-lg text-[#77796F] leading-relaxed max-w-3xl mb-10">
                A behind-the-scenes look at an unreleased terminal operating system, focused on streamlining
                operational planning and vessel entry workflows for port operators.
            </p>

            <!-- Hero + manual prev/next controls, counter -->
            <div class="max-w-3xl mx-auto">
                <div class="bg-card-light rounded-2xl shadow-sm aspect-[16/9] flex items-center justify-center overflow-hidden cursor-pointer group"
                    onclick="openLightbox(currentIndex)">
                    <img alt="Project view" class="w-full h-full object-cover transition-opacity duration-150" id="main-carousel-image"
                        src="/assets/Ops Plan Detail 1.webp" loading="lazy" decoding="async">
                </div>
                <div class="flex items-center justify-center gap-6 mt-5">
                    <button type="button" onclick="updateCarousel((currentIndex - 1 + projectData.length) % projectData.length)" aria-label="Previous"
                        class="w-9 h-9 rounded-full border border-black/10 flex items-center justify-center hover:bg-black/5 active:scale-90 transition-all focus-ring cursor-pointer">
                        <span class="material-symbols-outlined opacity-60">chevron_left</span>
                    </button>
                    <span class="text-xs opacity-50 font-mono" id="desktop-carousel-counter">01 / 04</span>
                    <button type="button" onclick="updateCarousel((currentIndex + 1) % projectData.length)" aria-label="Next"
                        class="w-9 h-9 rounded-full border border-black/10 flex items-center justify-center hover:bg-black/5 active:scale-90 transition-all focus-ring cursor-pointer">
                        <span class="material-symbols-outlined opacity-60">chevron_right</span>
                    </button>
                </div>
            </div>

            <!-- Gallery: 4-thumbnail grid, numbered, same projectData as hero -->
            <div class="mt-16">
                <div class="flex items-baseline justify-between mb-5">
                    <p class="text-xl font-semibold tracking-tight">Gallery</p>
                    <p class="text-[0.65rem] uppercase tracking-[0.15em] text-[#244BFF]">4 VIEWS</p>
                </div>
                <div class="grid grid-cols-4 gap-4" id="desktop-gallery-grid">
                    <button type="button" class="carousel-thumb-btn active group text-left" onclick="updateCarousel(0)">
                        <span class="block aspect-square rounded-lg overflow-hidden border border-black/10"><img alt="Thumbnail 1" class="w-full h-full object-cover" src="/assets/Ops Plan Detail 1.webp" loading="lazy" decoding="async"></span>
                        <span class="block text-xs mt-2 opacity-50">01</span>
                    </button>
                    <button type="button" class="carousel-thumb-btn group text-left" onclick="updateCarousel(1)">
                        <span class="block aspect-square rounded-lg overflow-hidden border border-black/10"><img alt="Thumbnail 2" class="w-full h-full object-cover" src="/assets/Ops Plan.webp" loading="lazy" decoding="async"></span>
                        <span class="block text-xs mt-2 opacity-50">02</span>
                    </button>
                    <button type="button" class="carousel-thumb-btn group text-left" onclick="updateCarousel(2)">
                        <span class="block aspect-square rounded-lg overflow-hidden border border-black/10"><img alt="Thumbnail 3" class="w-full h-full object-cover" src="/assets/ENTRY.webp" loading="lazy" decoding="async"></span>
                        <span class="block text-xs mt-2 opacity-50">03</span>
                    </button>
                    <button type="button" class="carousel-thumb-btn group text-left" onclick="updateCarousel(3)">
                        <span class="block aspect-square rounded-lg overflow-hidden border border-black/10"><img alt="Thumbnail 4" class="w-full h-full object-cover" src="/assets/ENTRY FORM.webp" loading="lazy" decoding="async"></span>
                        <span class="block text-xs mt-2 opacity-50">04</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Case Studies Section -->
        <section class="mt-32 reveal-item">
            <div class="mb-16">
                <span class="text-[11px] font-bold tracking-[0.3em] text-[#77796F] uppercase mb-4 block">Case Study</span>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tight">The Problem & Solution</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
                <!-- The Problem -->
                <div class="bg-card-light p-8 md:p-10 rounded-2xl shadow-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-red-500 text-xl">warning</span>
                        </div>
                        <h3 class="text-xl font-bold">The Problem</h3>
                    </div>
                    <p class="text-[#77796F] leading-relaxed mb-6">
                        Pelindo wanted to <strong class="text-[#20211F]">sell their Terminal Operating System to other ports</strong> outside the Pelindo ecosystem — but the existing PTOS-M was tightly coupled to internal workflows and branding.
                    </p>
                    <ul class="space-y-3 text-sm text-[#77796F]">
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-red-400 text-base mt-0.5">close</span>
                            <span>Existing TOS built specifically for Pelindo's internal needs</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-red-400 text-base mt-0.5">close</span>
                            <span>Not flexible enough for different port configurations</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-red-400 text-base mt-0.5">close</span>
                            <span>UI felt dated compared to modern SaaS products</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-red-400 text-base mt-0.5">close</span>
                            <span>All-or-nothing approach — ports had to buy modules they didn't need</span>
                        </li>
                    </ul>
                </div>

                <!-- The Solution -->
                <div class="bg-card-light p-8 md:p-10 rounded-2xl shadow-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-green-500 text-xl">check_circle</span>
                        </div>
                        <h3 class="text-xl font-bold">The Solution: Modular TOS</h3>
                    </div>
                    <p class="text-[#77796F] leading-relaxed mb-6">
                        A <strong class="text-[#20211F]">white-label, modular TOS</strong> designed for external ports — same core capabilities as PTOS-M, but with a modern UI, cleaner flow, and complete flexibility.
                    </p>
                    <ul class="space-y-3 text-sm text-[#77796F]">
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-green-400 text-base mt-0.5">check</span>
                            <span>Modern, cleaner UI with simpler navigation flow</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-green-400 text-base mt-0.5">check</span>
                            <span>Pick only the modules you need — billing, operations, reporting, or all</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-green-400 text-base mt-0.5">check</span>
                            <span>Missing "Pelayanan Kapal"? No problem — add it anytime</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-green-400 text-base mt-0.5">check</span>
                            <span>White-label ready for any port's branding</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Key Features -->
            <div class="bg-card-light p-8 md:p-12 rounded-2xl shadow-sm">
                <h3 class="text-2xl font-bold mb-8">Key Features Delivered</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex flex-col">
                        <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined text-2xl">tune</span>
                        </div>
                        <h4 class="font-bold mb-2">Modular Architecture</h4>
                        <p class="text-sm text-[#77796F] leading-relaxed">
                            Start with billing only, add operations later, include reporting when ready. Ports pay for what they use, nothing more.
                        </p>
                    </div>
                    <div class="flex flex-col">
                        <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined text-2xl">palette</span>
                        </div>
                        <h4 class="font-bold mb-2">Modern UI/UX</h4>
                        <p class="text-sm text-[#77796F] leading-relaxed">
                            Cleaner interface with simplified flows. Less clicks to complete tasks, better visual hierarchy, modern design language.
                        </p>
                    </div>
                    <div class="flex flex-col">
                        <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined text-2xl">deployed_code</span>
                        </div>
                        <h4 class="font-bold mb-2">White-Label Ready</h4>
                        <p class="text-sm text-[#77796F] leading-relaxed">
                            Built to be rebranded. Any port can deploy this TOS under their own identity without feeling like a Pelindo product.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script>
        const projectData = [
            {
                title: "In-Depth Ops Plan Detail",
                description: "A granular operational plan view that surfaces berth allocations, schedules, and resource assignments in a single, focused workspace.",
                image: "/assets/Ops Plan Detail 1.webp"
            },
            {
                title: "Operations Planning Overview",
                description: "A high-level operations board that visualizes berth schedules and vessel timelines, giving planners a clear pulse of daily terminal activity.",
                image: "/assets/Ops Plan.webp"
            },
            {
                title: "Vessel Entry Management",
                description: "A centralized entry log that tracks incoming vessels, status updates, and key milestones with a clean, scannable layout.",
                image: "/assets/ENTRY.webp"
            },
            {
                title: "Streamlined Entry Form",
                description: "A guided form that simplifies vessel entry submissions, reducing data entry friction while ensuring required terminal information is captured accurately.",
                image: "/assets/ENTRY FORM.webp"
            }
        ];
        // Mobile: hero carousel (dots + prev/next) and gallery grid, built from
        // the same projectData the desktop feature-carousel uses — single
        // source of truth, no duplicated content.
        let mobileCarouselIndex = 0;
        function renderMobileCarousel() {
            const heroImg = document.getElementById('mobile-hero-image');
            const dotsWrap = document.getElementById('mobile-carousel-dots');
            if (!heroImg || !dotsWrap) return;
            heroImg.src = projectData[mobileCarouselIndex].image;
            dotsWrap.innerHTML = '';
            projectData.forEach((_, i) => {
                const dot = document.createElement('span');
                dot.className = `w-1.5 h-1.5 rounded-full transition-colors duration-200 ${i === mobileCarouselIndex ? 'bg-[#244BFF]' : 'bg-black/15'}`;
                dotsWrap.appendChild(dot);
            });
        }
        function mobileCarouselStep(delta) {
            mobileCarouselIndex = (mobileCarouselIndex + delta + projectData.length) % projectData.length;
            renderMobileCarousel();
            renderMobileGallery();
        }
        function renderMobileGallery() {
            const grid = document.getElementById('mobile-gallery-grid');
            const count = document.getElementById('mobile-gallery-count');
            if (!grid) return;
            count.textContent = `0${projectData.length} VIEWS`;
            grid.innerHTML = projectData.map((item, i) => `
                <button type="button" onclick="mobileCarouselIndex = ${i}; renderMobileCarousel(); renderMobileGallery(); document.getElementById('mobile-hero-wrap').scrollIntoView({behavior:'smooth', block:'start'});" class="text-left active:opacity-60 focus-ring">
                    <span class="block aspect-square overflow-hidden rounded-sm border ${i === mobileCarouselIndex ? 'border-[#244BFF]' : 'border-black/10'}"><img alt="${item.title}" loading="lazy" src="${item.image}" class="w-full h-full object-cover"></span>
                    <span class="block text-xs mt-2 ${i === mobileCarouselIndex ? 'text-[#244BFF]' : 'opacity-50'}">0${i + 1}</span>
                </button>
            `).join('');
        }
        if (window.innerWidth < 768) {
            renderMobileCarousel();
            renderMobileGallery();
        }

        let currentIndex = 0;
        function updateCarousel(index) {
            currentIndex = index;
            const content = projectData[index];
            const mainImg = document.getElementById('main-carousel-image');
            const counter = document.getElementById('desktop-carousel-counter');
            mainImg.style.opacity = '0';
            setTimeout(() => {
                mainImg.src = content.image;
                mainImg.style.opacity = '1';
                if (counter) counter.textContent = `0${index + 1} / 0${projectData.length}`;
                document.querySelectorAll('.carousel-thumb-btn').forEach((btn, i) => {
                    if (i === index) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            }, 150);
        }
        function nextSlide() {
            let nextIndex = (currentIndex + 1) % projectData.length;
            updateCarousel(nextIndex);
        }

        updateCarousel(0);
    </script>

    <!-- Image Lightbox Modal -->
    <div id="image-lightbox"
        class="fixed inset-0 z-[60] bg-black/90 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300 flex flex-col items-center justify-center p-4 cursor-zoom-out">
        <!-- Navigation Arrows -->
        <button id="lightbox-prev"
            class="absolute left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10 transition-colors p-3 bg-black/20 rounded-full backdrop-blur-md">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </button>
        <button id="lightbox-next"
            class="absolute right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10 transition-colors p-3 bg-black/20 rounded-full backdrop-blur-md">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>
        <div class="relative w-full max-w-7xl flex-1 flex items-center justify-center min-h-0">
            <div class="relative inline-block">
                <img id="lightbox-image" src="" alt="Expanded Work"
                    class="max-w-full max-h-[85vh] object-contain scale-95 transition-transform duration-300 rounded-lg shadow-2xl cursor-default select-none"
                    onclick="event.stopPropagation()"  loading="lazy" decoding="async">
                <button id="lightbox-close"
                    class="absolute top-4 right-4 text-white/80 hover:text-white z-20 transition-colors p-2 bg-black/50 rounded-full backdrop-blur-md"
                    onclick="event.stopPropagation()">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
        </div>
        <!-- Thumbnail Gallery Strip -->
        <div id="lightbox-gallery-strip"
            class="w-fit max-w-4xl h-20 mt-4 flex items-center justify-start gap-4 overflow-x-auto px-4 pb-2 z-10"
            onclick="event.stopPropagation()">
        </div>
    </div>

    <script>
        // Lightbox Logic
        const lightbox = document.getElementById('image-lightbox');
        const lightboxImg = document.getElementById('lightbox-image');
        const lightboxCloseBtn = document.getElementById('lightbox-close');
        const lightboxPrevBtn = document.getElementById('lightbox-prev');
        const lightboxNextBtn = document.getElementById('lightbox-next');
        const lightboxGalleryStrip = document.getElementById('lightbox-gallery-strip');
        let lightboxIndex = 0;

        function openLightbox(index) {
            lightboxIndex = index;
            updateLightboxImage();
            lightbox.classList.remove('hidden');
            void lightbox.offsetWidth;
            lightbox.classList.remove('opacity-0');
            lightboxImg.classList.remove('scale-95');
            lightboxImg.classList.add('scale-100');
            document.body.classList.add('overflow-hidden');
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            lightboxImg.classList.remove('scale-100');
            lightboxImg.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }, 300);
        }

        function updateLightboxImage() {
            const content = projectData[lightboxIndex];
            lightboxImg.src = content.image;

            // Update gallery strip
            lightboxGalleryStrip.innerHTML = '';
            projectData.forEach((item, i) => {
                const thumbBtn = document.createElement('button');
                thumbBtn.className = `w-16 h-16 rounded-lg overflow-hidden border-2 transition-all ${i === lightboxIndex ? 'border-white opacity-100 scale-105' : 'border-transparent opacity-60 hover:opacity-100'}`;
                const thumbImg = document.createElement('img');
                thumbImg.src = item.image;
                thumbImg.className = 'w-full h-full object-cover';
                thumbBtn.appendChild(thumbImg);
                thumbBtn.onclick = () => {
                    lightboxIndex = i;
                    lightboxImg.classList.add('opacity-50');
                    setTimeout(() => {
                        updateLightboxImage();
                        lightboxImg.classList.remove('opacity-50');
                    }, 150);
                };
                lightboxGalleryStrip.appendChild(thumbBtn);
            });
        }

        function lightboxPrev() {
            lightboxIndex = (lightboxIndex - 1 + projectData.length) % projectData.length;
            lightboxImg.classList.add('opacity-50');
            setTimeout(() => {
                updateLightboxImage();
                lightboxImg.classList.remove('opacity-50');
            }, 150);
        }

        function lightboxNext() {
            lightboxIndex = (lightboxIndex + 1) % projectData.length;
            lightboxImg.classList.add('opacity-50');
            setTimeout(() => {
                updateLightboxImage();
                lightboxImg.classList.remove('opacity-50');
            }, 150);
        }

        lightboxCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeLightbox();
        });

        lightboxPrevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            lightboxPrev();
        });

        lightboxNextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            lightboxNext();
        });

        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') lightboxPrev();
                if (e.key === 'ArrowRight') lightboxNext();
            }
        });
    </script>

    <script>
        // Reveal animation
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const isReducedMotion = () => prefersReducedMotion.matches;

        const revealItems = document.querySelectorAll('.reveal-item');

        if (isReducedMotion()) {
            revealItems.forEach((el) => {
                el.classList.add('reveal-init', 'reveal-active');
            });
        } else {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        const alreadyPlayed = entry.target.dataset.revealed === 'true';
                        const delay = alreadyPlayed ? 0 : index * 110;
                        setTimeout(() => {
                            entry.target.classList.add('reveal-active');
                            entry.target.dataset.revealed = 'true';
                        }, delay);
                    } else {
                        entry.target.classList.remove('reveal-active');
                    }
                });
            }, {
                threshold: 0.08,
                rootMargin: '0px 0px -8% 0px'
            });

            revealItems.forEach((el) => {
                el.classList.add('reveal-init');
                observer.observe(el);
            });
        }
    </script>

</body>

</html>
