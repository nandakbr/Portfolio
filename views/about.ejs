<!DOCTYPE html>
<html class="scroll-smooth" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta property="og:title" content="Nanda Akbar — Resume" />
    <meta property="og:description" content="Product Designer with hands-on experience designing enterprise software used daily by operators across 80+ physical sites." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nandakbrportfolio.netlify.app/about" />
    <meta property="og:image" content="/assets/Profile.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nanda Akbar — Resume" />
    <meta name="twitter:description" content="Product Designer with hands-on experience designing enterprise software used daily by operators across 80+ physical sites." />
    <meta name="twitter:image" content="/assets/Profile.webp" />
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Tinos:ital@1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-background-light text-[#20211F] transition-colors duration-300">
    <!-- Mobile only: flat back bar (desktop opens this page inside the iframe window). -->
    <header class="md:hidden sticky top-0 z-50 flex items-center justify-between px-6 py-2 bg-background-light/90 backdrop-blur border-b border-black/10">
        <a href="/" class="flex items-center gap-1 text-sm py-2 focus-ring" aria-label="Back to index"><span class="material-symbols-outlined text-lg">arrow_back</span>Index</a>
        <a href="/" class="text-xs opacity-50 py-2 focus-ring">Nanda Akbar</a>
    </header>
    <main class="max-w-3xl mx-auto px-6 md:px-0 pt-10 pb-16">
        <!-- Resume as a window-chrome document: titlebar + printable-feel content -->
        <div class="rounded-lg overflow-hidden shadow-lg border border-black/10 bg-surface-window reveal-item" data-delay="100">
            <!-- Document content (no internal window chrome — this is always opened inside the
                 homepage's draggable case-study window, which already provides that chrome) -->
            <div class="p-8 md:p-14">
                <!-- Identity -->
                <div class="mb-10 pb-8 border-b border-black/10">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] text-[#244BFF]">Résumé</p>
                        <a href="/assets/CV_Nanda_A.pdf" download
                            class="shrink-0 flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border border-black/10 opacity-60 hover:opacity-100 active:opacity-40 transition-opacity focus-ring cursor-pointer">
                            <span class="material-symbols-outlined text-base">download</span>
                            PDF
                        </a>
                    </div>
                    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-1">Nanda A Akbar</h1>
                    <p class="text-base opacity-60 mb-5">Product Designer</p>

                    <!-- contact.txt: window-chrome card, consistent with the folder/case-study
                         window identity used across the rest of the site. -->
                    <div class="rounded-lg border border-black/10 overflow-hidden">
                        <div class="flex items-center gap-[9px] px-[11px] h-[27px] bg-surface-titlebar-alt border-b border-black/10">
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="flex-1 text-center text-[0.65rem] opacity-50">contact.txt</span>
                            <button type="button" onclick="navigator.clipboard.writeText('nandaakbar70@gmail.com')" aria-label="Copy email" class="text-xs opacity-40 hover:opacity-100 active:opacity-50 transition-opacity focus-ring cursor-pointer">
                                <span class="material-symbols-outlined text-sm">content_copy</span>
                            </button>
                        </div>
                        <div class="px-4 py-3.5 space-y-1.5 text-xs font-mono">
                            <p><span class="opacity-40">EMAIL</span> &nbsp;nandaakbar70@gmail.com</p>
                            <p><span class="opacity-40">PHONE</span> &nbsp;+62 822 4630 8605</p>
                            <p><span class="opacity-40">LOCATION</span> &nbsp;Indonesia (Remote)</p>
                            <p><span class="opacity-40">PORTFOLIO</span> &nbsp;<a href="https://nandakbrportfolio.netlify.app" class="text-[#244BFF] hover:underline focus-ring cursor-pointer">nandakbrportfolio.netlify.app</a></p>
                            <p><span class="opacity-40">LINKEDIN</span> &nbsp;<a href="https://linkedin.com/in/nandaakbr" class="text-[#244BFF] hover:underline focus-ring cursor-pointer">linkedin.com/in/nandaakbr</a></p>
                        </div>
                    </div>
                </div>

                <!-- Summary -->
                <section class="mb-10">
                    <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] opacity-40 mb-3">Summary</p>
                    <p class="text-sm leading-relaxed opacity-80">
                        Product Designer with hands-on experience designing enterprise software used daily by operators across 80+ physical sites, backed by 2+ prior years working directly on the same system as an implementor and engineer. Also has working frontend ability (Vue.js, HTML/CSS) to prototype and ship close to production. Led end-to-end design for a terminal operating system and a unified authentication platform consolidating 3 separate systems into one, and rebuilt a 300+ component design system now shared across the product suite. Comfortable owning ambiguous, operationally complex workflows and collaborating async across distributed, cross-functional teams.
                    </p>
                </section>

                <!-- Skills -->
                <section class="mb-10">
                    <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] opacity-40 mb-3">Skills</p>
                    <div class="flex flex-wrap gap-2">
                        <% ["Product Design", "User Experience (UX)", "Interaction Design", "Design Systems", "Information Architecture", "Prototyping", "Usability Testing", "User Research", "User Flows", "Figma", "Vue.js", "HTML / CSS", "REST API Integration", "Adobe Illustrator"].forEach(skill => { %>
                        <span class="text-xs px-3 py-1.5 rounded-full border border-black/10 opacity-70"><%= skill %></span>
                        <% }) %>
                    </div>
                </section>

                <!-- Experience -->
                <section class="mb-10">
                    <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] opacity-40 mb-5">Experience</p>
                    <div class="space-y-8">
                        <div>
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-2">
                                <h3 class="text-base font-bold">Product Designer / Frontend Developer</h3>
                                <span class="text-xs opacity-40 shrink-0">May 2025 – Current</span>
                            </div>
                            <p class="text-xs opacity-50 mb-3">Pelindo Solusi Digital — enterprise software for Indonesia's national port operator</p>
                            <ul class="text-sm leading-relaxed opacity-80 space-y-1.5 list-disc list-outside ml-4">
                                <li>Owned end-to-end product design for a terminal operating system live across 80+ operational sites nationwide, translating complex logistics workflows into enterprise interfaces for daily operator use.</li>
                                <li>Designed a unified authentication platform consolidating 3 separate systems into a single secured sign-on flow, reducing operator login entry points from 3 to 1.</li>
                                <li>Led UI/UX for a modular, white-label version of the core product for external customers, with configurable workflows and per-client branding.</li>
                                <li>Rebuilt the design system and component library (300+ reusable components) now adopted as the shared standard across the full product suite.</li>
                                <li>Implemented responsive interfaces (Vue.js, HTML/CSS) integrated with REST APIs, maintaining design fidelity from Figma through to production.</li>
                                <li>Partnered with engineering, product, and operations stakeholders across discovery, implementation, and validation phases.</li>
                            </ul>
                        </div>

                        <div>
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-2">
                                <h3 class="text-base font-bold">System Implementor</h3>
                                <span class="text-xs opacity-40 shrink-0">May 2023 – May 2025</span>
                            </div>
                            <p class="text-xs opacity-50 mb-3">Pelindo Solusi Digital</p>
                            <ul class="text-sm leading-relaxed opacity-80 space-y-1.5 list-disc list-outside ml-4">
                                <li>Deployed and supported the core operating system across live operational terminals, working directly with end users to resolve real-world usability issues — direct input into later design decisions.</li>
                                <li>Translated field feedback into functional requirements for the development team.</li>
                                <li>Authored system documentation and conducted testing to verify correct operation before rollout.</li>
                            </ul>
                        </div>

                        <div>
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-2">
                                <h3 class="text-base font-bold">Engineer Onsite</h3>
                                <span class="text-xs opacity-40 shrink-0">Jul 2022 – May 2023</span>
                            </div>
                            <p class="text-xs opacity-50 mb-3">Pelindo Solusi Digital</p>
                            <ul class="text-sm leading-relaxed opacity-80 space-y-1.5 list-disc list-outside ml-4">
                                <li>Diagnosed user-reported issues through test scripts and root-cause analysis in a 24/7 uptime environment.</li>
                                <li>Provided hands-on operational support across shifts spanning multiple time zones.</li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Education + Languages -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <section>
                        <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] opacity-40 mb-3">Education</p>
                        <h3 class="text-sm font-bold">Brawijaya University</h3>
                        <p class="text-xs opacity-50">Information Technology — Malang, East Java</p>
                    </section>
                    <section>
                        <p class="text-[0.65rem] font-black uppercase tracking-[0.3em] opacity-40 mb-3">Languages</p>
                        <p class="text-sm opacity-80">English (Professional Working Proficiency)</p>
                        <p class="text-sm opacity-80">Indonesian (Native)</p>
                    </section>
                </div>
            </div>
        </div>
    </main>

    <script>
        const revealItems = document.querySelectorAll('.reveal-item');
        revealItems.forEach((el) => {
            el.classList.add('reveal-init');
            requestAnimationFrame(() => {
                setTimeout(() => el.classList.add('reveal-active'), 100);
            });
        });
    </script>
</body>

</html>
