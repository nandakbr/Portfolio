    <style>
        /* Case-study window loader: the iframe window is empty white until the page answers (live TTFB ~0.9s + assets). */
        .ifl { position: absolute; left: 0; right: 0; bottom: 0; top: 34px; z-index: 5; background: #FAF9F4; overflow: hidden; transition: opacity 250ms cubic-bezier(.16,1,.3,1); }
        .ifl[hidden] { display: none; }
        .ifl.is-out { opacity: 0; pointer-events: none; }
        .ifl-bar { position: absolute; left: 0; top: 0; right: 0; height: 3px; z-index: 2; }
        .ifl-bar i { display: block; height: 100%; background: #244BFF; transform-origin: left; transform: scaleX(.06); transition: transform 450ms cubic-bezier(.16,1,.3,1); }
        .ifl-body { padding: 32px 48px; display: grid; gap: 14px; justify-items: start; opacity: 0; animation: iflIn 250ms ease 120ms forwards; }
        .ifl-s { display: block; border-radius: 6px; background: linear-gradient(90deg, #E6E6DE 25%, #EEECE4 50%, #E6E6DE 75%); background-size: 200% 100%; animation: iflShim 1.4s linear infinite; }
        .ifl-msg { position: absolute; left: 0; right: 0; bottom: 20px; margin: 0; text-align: center; font-size: 12px; color: #77796F; }
        .ifl-msg button { font: inherit; font-size: 12px; font-weight: 500; color: #FAF9F4; background: #20211F; border: 0; border-radius: 999px; padding: 6px 14px; margin-left: 8px; cursor: pointer; }
        .ifl-msg button:focus-visible { outline: 2px solid #244BFF; outline-offset: 2px; }
        @keyframes iflShim { from { background-position: 200% 0; } to { background-position: -200% 0; } }
        @keyframes iflIn { to { opacity: 1; } }
        @media (max-width: 767px) { .ifl-body { padding: 20px 16px; } }
        @media (prefers-reduced-motion: reduce) { .ifl-s { animation: none; } .ifl-bar i, .ifl { transition: none; } .ifl-body { animation-duration: 1ms; } }
    </style>
</head>

