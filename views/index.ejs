    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script>
        // Single source of truth for "desktop window-system" mode, mirroring the
        // CSS media queries in input.css (min-width:768px AND landscape). Tablet
        // portrait (width>=768 but portrait) behaves like mobile here: no drag,
        // no canvas-scaling, case-study links navigate instead of opening a window.
        function isDesktopMode() {
            return window.innerWidth >= 768 && window.innerWidth > window.innerHeight;
        }

        // Category folder windows: multi-window, draggable, bring-to-front
        const folderLayer = document.getElementById('folderWindowLayer');
        const folderTriggers = document.querySelectorAll('[data-folder-trigger]');
        const folderWindows = Array.from(document.querySelectorAll('[data-folder-window]'));
        let openFolderCount = 0;
        let topZIndex = 55; // starts above the fixed header (z-50) and page widgets (z-10/z-30)

        function bringToFront(win) {
            topZIndex += 1;
            win.style.zIndex = String(topZIndex);
            setActiveWindow(win);
        }

        // Active vs. idle titlebar tint: only the frontmost window gets the
        // warmer surface/titlebar color: Figma DS 05 "Window / Visual states".
        function setActiveWindow(win) {
            [...folderWindows, imageExpandWindow, iframeWindow].forEach((w) => {
                if (w) w.classList.remove('is-active-window');
            });
            win.classList.add('is-active-window');
        }

        function openFolderWindow(key) {
            const win = folderWindows.find((w) => w.dataset.folderWindow === key);
            if (!win) return;

            // Already open — just bring it to front, don't re-measure/reposition
            // (re-running the position math while open caused a visible jump/drift).
            if (win.classList.contains('is-open')) {
                bringToFront(win);
                return;
            }

            const wasClosed = !win.classList.contains('is-open');
            folderLayer.classList.remove('hidden');
            win.style.pointerEvents = 'auto';

            // Only reset scale if the window hasn't been dragged into a custom
            // left/top position yet (dragged windows keep transform: none).
            if (win.dataset.dragged !== 'true') {
                win.style.transform = win.style.transform.replace('scale(0.9)', 'scale(1)');
            }
            requestAnimationFrame(() => win.classList.add('is-open'));
            bringToFront(win);
            if (wasClosed) openFolderCount += 1;
            document.body.style.overflow = 'hidden';
        }

        function closeFolderWindow(key) {
            const win = folderWindows.find((w) => w.dataset.folderWindow === key);
            if (win && win.classList.contains('is-open')) {
                win.classList.remove('is-open');
                win.style.pointerEvents = 'none';
                if (win.dataset.dragged !== 'true') {
                    win.style.transform = win.style.transform.replace('scale(1)', 'scale(0.9)');
                }
                openFolderCount = Math.max(0, openFolderCount - 1);
            }
            if (openFolderCount === 0) {
                document.body.style.overflow = '';
                folderLayer.classList.remove('pointer-events-auto');
                setTimeout(() => {
                    if (openFolderCount === 0) folderLayer.classList.add('hidden');
                }, 320);
            }
        }

        folderTriggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
                // Click feedback on the icon itself: a quick squash-and-pop
                // so the folder visibly "reacts" before its window animates
                // in — closes the gap between intent (click) and the window
                // appearing a beat later.
                const icon = trigger.querySelector('svg, img');
                if (icon && window.gsap) {
                    gsap.fromTo(icon,
                        { scale: 0.82, rotate: -4 },
                        { scale: 1, rotate: 0, duration: 0.55, ease: 'elastic.out(1, 0.5)' }
                    );
                }
                openFolderWindow(trigger.dataset.folderTrigger);
            });
        });

        // (sidebar category switch removed — Packaging/Social Media are their own windows)

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            const topWin = folderWindows
                .filter((w) => !w.classList.contains('hidden'))
                .sort((a, b) => (parseInt(b.style.zIndex, 10) || 0) - (parseInt(a.style.zIndex, 10) || 0))[0];
            if (topWin) closeFolderWindow(topWin.dataset.folderWindow);
        });

        // Drag logic: pointerdown on titlebar, move the window, bring to front
        // (reusable — called for folder windows AND the case-study iframe window)
        function setupWindowDrag(win) {
            const titlebar = win.querySelector('.folder-window-titlebar, .iframe-window-titlebar, .image-expand-window-titlebar');
            if (!titlebar) return;

            win.addEventListener('pointerdown', () => bringToFront(win));

            titlebar.addEventListener('pointerdown', (e) => {
                if (!isDesktopMode()) return; // fullscreen on mobile / un-scaled window-stack on tablet portrait — no drag
                if (e.target.closest('button')) return; // don't drag when clicking the close dot
                e.preventDefault(); // stop the browser's native text-selection drag
                bringToFront(win);

                const rect = win.getBoundingClientRect();
                // Switch from centered (transform: translateX(-50%)) to absolute top/left
                // so dragging math stays simple (no transform offset to account for).
                win.style.left = `${rect.left}px`;
                win.style.top = `${rect.top}px`;
                win.style.transform = 'none';
                win.dataset.dragged = 'true';
                win.style.transition = 'none'; // disable the open/close transition while dragging

                const startX = e.clientX;
                const startY = e.clientY;
                const startLeft = rect.left;
                const startTop = rect.top;
                titlebar.style.cursor = 'grabbing';
                document.body.style.userSelect = 'none'; // prevent text selection while dragging

                function onMove(moveEvent) {
                    const dx = moveEvent.clientX - startX;
                    const dy = moveEvent.clientY - startY;
                    win.style.left = `${startLeft + dx}px`;
                    win.style.top = `${startTop + dy}px`;
                }

                function onUp() {
                    titlebar.style.cursor = 'grab';
                    win.style.transition = ''; // re-enable transition for future open/close
                    document.body.style.userSelect = '';
                    document.removeEventListener('pointermove', onMove);
                    document.removeEventListener('pointerup', onUp);
                }

                document.addEventListener('pointermove', onMove);
                document.addEventListener('pointerup', onUp);
            });
        }

        folderWindows.forEach(setupWindowDrag);

        // Desktop stage: the Figma canvas is a fixed 1440x1000 design surface.
        // Real viewports are rarely that exact size, so scale the whole stage
        // down (never up) to fit — "one page, no scroll" actually holds instead
        // of overflowing on any laptop smaller than 1440x1000.
        function fitDesktopStage() {
            const wrap = document.getElementById('desktopStageWrap');
            const stage = document.getElementById('desktopStage');
            if (!wrap || !stage || !isDesktopMode()) return;
            const availW = wrap.clientWidth;
            const availH = wrap.clientHeight;
            const ratio = Math.min(1, availW / 1440, availH / 1000);
            stage.style.transform = `translate(-50%, -50%) scale(${ratio})`;
        }
        window.addEventListener('resize', fitDesktopStage);
        fitDesktopStage();

        // Tablet portrait: responsive width (fills the real viewport, no
        // scale-to-fit) but height stays locked to 100vh — orientationchange
        // still needs to re-run fitDesktopStage() for the landscape case.
        window.addEventListener('orientationchange', fitDesktopStage);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const isReducedMotion = () => prefersReducedMotion.matches;

        // Iframe Modal Logic (draggable window-chrome)
        const iframeModal = document.getElementById('iframe-modal');
        const iframeWindow = document.getElementById('iframe-window');
        const modalIframe = document.getElementById('modal-iframe');
        const iframeUrlbar = document.getElementById('iframe-window-urlbar');
        const closeModalBtn = document.getElementById('iframe-modal-close');

        const caseStudyLabels = {
            '/unreleased-tos': 'nandakbrportfolio.netlify.app/unreleased-tos',
            '/ptosm': 'nandakbrportfolio.netlify.app/ptosm',
            '/ptos-sso': 'nandakbrportfolio.netlify.app/ptos-sso',
            '/ptosm-ui-lib': 'nandakbrportfolio.netlify.app/ptosm-ui-lib',
            '/bea-cukai': 'nandakbrportfolio.netlify.app/bea-cukai',
            '/about': 'nandakbrportfolio.netlify.app/about',
        };

        // Image Expand Logic
        const imageExpandModal = document.getElementById('image-expand-modal');
        const imageExpandWindow = document.getElementById('image-expand-window');
        const imageExpandImg = document.getElementById('image-expand-img');
        const imageExpandLabel = document.getElementById('image-expand-label');

        const imageExpandLabels = {
            '/assets/packaging/arjuna.png': 'Arjuna',
            '/assets/packaging/arjuna%20pm.png': 'Arjuna PM',
            '/assets/packaging/blue%20mountain.webp': 'Blue Mountain',
            '/assets/packaging/gayo%20red%20bourbon.jpg': 'Gayo Red Bourbon',
            '/assets/packaging/gayo%20red%20-%20%20kawi.png': 'Gayo Red - Kawi',
            '/assets/packaging/putuk%20gede%20-%20flores.png': 'Putuk Gede - Flores',
            '/assets/packaging/halu.webp': 'Halu',
            '/assets/social/cpopc%201.webp': 'CPOPC — CPOPC 1',
            '/assets/social/cpopc%202.webp': 'CPOPC — CPOPC 2',
            '/assets/social/cpopc%203.webp': 'CPOPC — CPOPC 3',
            '/assets/social/fotofeeds%201.webp': 'FotoFeeds — FotoFeeds 1',
            '/assets/social/fotofeeds%202.webp': 'FotoFeeds — FotoFeeds 2',
            '/assets/social/fotofeeds%203.webp': 'FotoFeeds — FotoFeeds 3',
            '/assets/social/labq%201.png': 'LabQ — LabQ 1',
            '/assets/social/labq%202.png': 'LabQ — LabQ 2',
            '/assets/social/labq%203.png': 'LabQ — LabQ 3',
            '/assets/social/maro%201.png': 'Maro — Maro 1',
            '/assets/social/maro%202.png': 'Maro — Maro 2',
            '/assets/social/maro%203.png': 'Maro — Maro 3',
            '/assets/social/perumnas%201.png': 'Perumnas — Perumnas 1',
            '/assets/social/perumnas%202.png': 'Perumnas — Perumnas 2',
            '/assets/social/perumnas%203.png': 'Perumnas — Perumnas 3',
            '/assets/social/perumnas%204.png': 'Perumnas — Perumnas 4',
            '/assets/social/shanas%201.png': 'Shanas — Shanas 1',
            '/assets/social/shanas%202.png': 'Shanas — Shanas 2',
            '/assets/social/shanas%203.png': 'Shanas — Shanas 3',
        };

        // Media controls (Packaging/Social lightbox): prev/next + thumbnail
        // strip, scoped to whichever series (folder) the opened image belongs
        // to — derived from imageExpandLabels' key order, so adding a new
        // image to that object is the only edit needed to extend this.
        const imageExpandPrevBtn = document.getElementById('image-expand-prev');
        const imageExpandNextBtn = document.getElementById('image-expand-next');
        const imageExpandCounter = document.getElementById('image-expand-counter');
        const imageExpandThumbs = document.getElementById('image-expand-thumbs');
        let currentImageSeries = [];
        let currentImageSeriesIndex = -1;

        function seriesKeyOf(src) {
            const match = src.match(/^\/assets\/([^/]+)\//);
            return match ? match[1] : null;
        }

        function renderImageExpandThumbs() {
            imageExpandThumbs.innerHTML = '';
            currentImageSeries.forEach((thumbSrc, i) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-md overflow-hidden border-2 transition-colors focus-ring cursor-pointer ' + (i === currentImageSeriesIndex ? 'border-[#244BFF]' : 'border-black/10 opacity-60 hover:opacity-100');
                btn.setAttribute('aria-label', imageExpandLabels[thumbSrc] || `Image ${i + 1}`);
                btn.onclick = () => openImageExpand(thumbSrc);
                const img = document.createElement('img');
                img.src = thumbSrc;
                img.loading = 'lazy';
                img.decoding = 'async';
                img.alt = '';
                img.className = 'w-full h-full object-cover';
                btn.appendChild(img);
                imageExpandThumbs.appendChild(btn);
            });
            const activeThumb = imageExpandThumbs.children[currentImageSeriesIndex];
            if (activeThumb) activeThumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        function stepImageExpand(delta) {
            if (!currentImageSeries.length) return;
            const nextIndex = (currentImageSeriesIndex + delta + currentImageSeries.length) % currentImageSeries.length;
            openImageExpand(currentImageSeries[nextIndex]);
        }

        function openImageExpand(src) {
            const key = seriesKeyOf(src);
            currentImageSeries = key ? Object.keys(imageExpandLabels).filter((k) => seriesKeyOf(k) === key) : [src];
            currentImageSeriesIndex = currentImageSeries.indexOf(src);

            imageExpandImg.src = src;
            imageExpandLabel.textContent = imageExpandLabels[src] || '';
            const hasMultiple = currentImageSeries.length > 1;
            imageExpandPrevBtn.classList.toggle('hidden', !hasMultiple);
            imageExpandNextBtn.classList.toggle('hidden', !hasMultiple);
            imageExpandCounter.classList.toggle('hidden', !hasMultiple);
            if (hasMultiple) {
                imageExpandCounter.textContent = `${currentImageSeriesIndex + 1} / ${currentImageSeries.length}`;
            }
            renderImageExpandThumbs();

            imageExpandModal.classList.remove('hidden');
            imageExpandWindow.style.pointerEvents = 'auto';
            if (imageExpandWindow.dataset.dragged !== 'true') {
                imageExpandWindow.style.transform = imageExpandWindow.style.transform.replace('scale(0.9)', 'scale(1)');
            }
            requestAnimationFrame(() => imageExpandWindow.classList.add('is-open'));
            bringToFront(imageExpandWindow);
            document.body.classList.add('overflow-hidden');
        }

        function closeImageExpand() {
            imageExpandWindow.classList.remove('is-open');
            imageExpandWindow.style.pointerEvents = 'none';
            if (imageExpandWindow.dataset.dragged !== 'true') {
                imageExpandWindow.style.transform = imageExpandWindow.style.transform.replace('scale(1)', 'scale(0.9)');
            }
            setTimeout(() => {
                imageExpandModal.classList.add('hidden');
                imageExpandImg.src = '';
                document.body.classList.remove('overflow-hidden');
            }, 320);
        }

        document.addEventListener('keydown', (e) => {
            if (imageExpandModal.classList.contains('hidden')) return;
            if (e.key === 'Escape') closeImageExpand();
            if (e.key === 'ArrowLeft') stepImageExpand(-1);
            if (e.key === 'ArrowRight') stepImageExpand(1);
        });

        setupWindowDrag(imageExpandWindow);

        document.getElementById('image-expand-close').addEventListener('click', closeImageExpand);

        function openIframeModal(url) {
            // Mobile: every window is fullscreen — the page itself is the window.
            if (window.innerWidth < 768) { window.location.href = url; return; }
            iflStart();
            modalIframe.src = url;
            iframeUrlbar.textContent = caseStudyLabels[url] || url;
            iframeModal.classList.remove('hidden');
            iframeWindow.style.pointerEvents = 'auto';
            if (iframeWindow.dataset.dragged !== 'true') {
                iframeWindow.style.transform = iframeWindow.style.transform.replace('scale(0.9)', 'scale(1)');
            }
            requestAnimationFrame(() => iframeWindow.classList.add('is-open'));
            bringToFront(iframeWindow);
            document.body.classList.add('overflow-hidden');
        }

        function closeIframeModal() {
            iframeWindow.classList.remove('is-open');
            iframeWindow.style.pointerEvents = 'none';
            if (iframeWindow.dataset.dragged !== 'true') {
                iframeWindow.style.transform = iframeWindow.style.transform.replace('scale(1)', 'scale(0.9)');
            }
            setTimeout(() => {
                iframeModal.classList.add('hidden');
                modalIframe.src = '';
                iflClear(); iframeLoader.hidden = true;
                document.body.classList.remove('overflow-hidden');
            }, 320);
        }

        closeModalBtn.addEventListener('click', closeIframeModal);

        // Case-study loader: show the skeleton the moment the window opens, finish on the iframe's load.
        // No byte-level progress exists for an iframe, so the bar creeps toward 90% and only completes on real load.
        const iframeLoader = document.getElementById('iframe-loader');
        const iframeLoaderBar = iframeLoader.querySelector('.ifl-bar i');
        const iframeLoaderMsg = document.getElementById('iframe-loader-msg');
        let iflTimers = [], iflPct = 0;
        function iflClear() { iflTimers.forEach((t) => { clearInterval(t); clearTimeout(t); }); iflTimers = []; }
        function iflPaint(p) { iflPct = p; iframeLoaderBar.style.transform = 'scaleX(' + (p / 100) + ')'; }
        function iflStart() {
            iflClear();
            iframeLoader.hidden = false;
            iframeLoader.classList.remove('is-out');
            iframeLoaderMsg.hidden = true;
            iflPaint(6);
            iflTimers.push(setInterval(() => iflPaint(iflPct + (90 - iflPct) * 0.1), 300));
            iflTimers.push(setTimeout(() => { iframeLoaderMsg.hidden = false; }, 10000));
            iflTimers.push(setTimeout(iflStop, 20000));   // never trap the window behind the loader
        }
        function iflStop() {
            iflClear();
            iflPaint(100);
            iflTimers.push(setTimeout(() => {
                iframeLoader.classList.add('is-out');
                iflTimers.push(setTimeout(() => { iframeLoader.hidden = true; }, 260));
            }, 140));
        }
        modalIframe.addEventListener('load', () => { if (modalIframe.getAttribute('src')) iflStop(); });
        document.getElementById('iframe-loader-retry').addEventListener('click', () => {
            const u = modalIframe.getAttribute('src');
            if (!u) return;
            iflStart();
            try { modalIframe.contentWindow.location.replace(u); } catch (e) { modalIframe.src = u; }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !iframeModal.classList.contains('hidden')) {
                closeIframeModal();
            }
        });

        // Register the case-study window into the same drag system as folder windows
        setupWindowDrag(iframeWindow);

        // NOTE: click-outside-to-close was removed — on a real desktop OS,
        // clicking empty space never closes a window (it only defocuses it).
        // Windows now close only via their close dot or Escape.


        // Refined scramble animation for "messy"
        const scrambleWord = document.getElementById('scramble-word');
        const clickWord = document.getElementById('click-word');
        const originalText = 'messy';
        const characters = 'yemss';

        const cursorPointer = document.getElementById('cursor-pointer');

        function triggerClickAnimation() {
            if (!clickWord) return;
            clickWord.style.transform = 'scale(1)';
            setTimeout(() => {
                clickWord.style.transform = 'scale(0.965)';
                if (cursorPointer) cursorPointer.style.transform = 'scale(0.8) translate(2px, 2px)';
                setTimeout(() => {
                    clickWord.style.transform = 'scale(1.015)';
                    if (cursorPointer) cursorPointer.style.transform = 'scale(1)';
                    setTimeout(() => {
                        clickWord.style.transform = 'scale(1)';
                    }, 180);
                }, 140);
            }, 620);
        }

        function scramble() {
            if (!scrambleWord) return;
            let iterations = 0;
            const interval = setInterval(() => {
                scrambleWord.innerText = originalText
                    .split('')
                    .map((letter, index) => {
                        if (index < iterations) return originalText[index];
                        return characters[Math.floor(Math.random() * characters.length)];
                    })
                    .join('');

                if (iterations >= originalText.length) {
                    clearInterval(interval);
                    triggerClickAnimation();
                }

                iterations += 1 / 5;
            }, 45);
        }

        if (isReducedMotion()) {
            if (scrambleWord) scrambleWord.innerText = originalText;
            if (clickWord) clickWord.style.transform = 'none';
            if (cursorPointer) cursorPointer.style.display = 'none';
        } else {
            scramble();
            setInterval(scramble, 4300);
        }

        // Cinematic reveal behavior
        // Running head (mobile): the header's right label follows whichever
        // [data-running] page is in view. Also drives the pill tab-bar active
        // state and the "01 / 03" page indicator. Tapping a tab scroll-jumps
        // to that page.
        (() => {
            const label = document.querySelector('[data-running-text]');
            const blocks = Array.from(document.querySelectorAll('[data-running]'));
            const root = document.getElementById('pageSnapContainer');
            const tabs = Array.from(document.querySelectorAll('.page-tab'));
            const indicator = document.getElementById('pageIndicator');
            if (!root || !blocks.length) return;

            let currentIndex = 0;
            let isUserClicking = false;
            let clickTimeout = null;

            const swap = (text) => {
                if (!label || !text || text === label.textContent) return;
                label.parentElement?.classList.add('is-swapping');
                setTimeout(() => {
                    label.textContent = text;
                    label.parentElement?.classList.remove('is-swapping');
                }, 160);
            };

            const setActivePage = (index) => {
                currentIndex = index;
                tabs.forEach((tab, i) => {
                    const active = i === index;
                    tab.classList.toggle('bg-surface-window', active);
                    tab.classList.toggle('shadow-sm', active);
                    tab.classList.toggle('text-[#20211F]', active);
                    tab.classList.toggle('opacity-50', !active);
                });
                if (indicator) {
                    indicator.textContent = `0${index + 1} / 03`;
                }
            };

            // Set initial state immediately
            setActivePage(0);

            // Click handling: instant UI feedback + rock-solid scrollTo
            tabs.forEach((tab) => {
                tab.addEventListener('click', (e) => {
                    e.preventDefault();
                    const index = parseInt(tab.dataset.pageJump, 10);
                    if (isNaN(index) || !blocks[index]) return;

                    isUserClicking = true;
                    clearTimeout(clickTimeout);
                    clickTimeout = setTimeout(() => { isUserClicking = false; }, 600);

                    setActivePage(index);
                    if (blocks[index].dataset.running) {
                        swap(blocks[index].dataset.running);
                    }

                    root.scrollTo({
                        left: blocks[index].offsetLeft,
                        behavior: 'smooth'
                    });
                });
            });

            // Swipe sync: tracks container scroll position in real time
            root.addEventListener('scroll', () => {
                if (isUserClicking) return;
                const scrollLeft = root.scrollLeft;
                const width = root.clientWidth || window.innerWidth;
                if (!width) return;
                const pageIndex = Math.round(scrollLeft / width);
                const clampedIndex = Math.max(0, Math.min(blocks.length - 1, pageIndex));
                if (clampedIndex !== currentIndex) {
                    setActivePage(clampedIndex);
                    if (blocks[clampedIndex] && blocks[clampedIndex].dataset.running) {
                        swap(blocks[clampedIndex].dataset.running);
                    }
                }
            }, { passive: true });

            // IntersectionObserver as resilient fallback
            if (window.IntersectionObserver) {
                const io = new IntersectionObserver((entries) => {
                    if (isUserClicking) return;
                    const visible = entries.find((e) => e.isIntersecting && e.intersectionRatio >= 0.5);
                    if (visible) {
                        const idx = blocks.indexOf(visible.target);
                        if (idx !== -1 && idx !== currentIndex) {
                            setActivePage(idx);
                            if (visible.target.dataset.running) {
                                swap(visible.target.dataset.running);
                            }
                        }
                    }
                }, { root, threshold: 0.5 });
                blocks.forEach((b) => io.observe(b));
            }
        })();

        const revealItems = document.querySelectorAll('.reveal-item');

        if (isReducedMotion()) {
            revealItems.forEach((el) => {
                el.classList.add('reveal-init', 'reveal-active');
            });
        } else {
            const observerOptions = {
                threshold: 0.08,
                rootMargin: '0px 0px -8% 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        const alreadyPlayed = entry.target.dataset.revealed === 'true';
                        const heroDelay = parseInt(entry.target.dataset.delay, 10) || 0;
                        const delay = alreadyPlayed ? 0 : (entry.target.dataset.delay ? heroDelay : index * 120);
                        setTimeout(() => {
                            entry.target.classList.add('reveal-active');
                            entry.target.dataset.revealed = 'true';
                        }, delay);
                    } else {
                        entry.target.classList.remove('reveal-active');
                    }
                });
            }, observerOptions);

            revealItems.forEach((el) => {
                el.classList.add('reveal-init');
                observer.observe(el);
            });
        }

        // Dock magnify — macOS-style: icon nearest the cursor scales up,
        // falloff to neighbours, matching the desktop-OS metaphor the whole
        // site is built on. Desktop/tablet only (needs a continuous pointer,
        // not touch); skipped entirely on touch-only devices via matchMedia
        // so mobile taps don't fight a half-applied transform.
        (function setupDockMagnify() {
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            [document.getElementById('dockDesktop'), document.getElementById('dockTablet')].forEach((dock) => {
                if (!dock) return;
                const icons = Array.from(dock.querySelectorAll('[data-folder-trigger] svg'));
                const MAX_SCALE = 1.35;
                const FALLOFF = 90; // px — distance at which influence reaches ~0
                dock.addEventListener('mousemove', (e) => {
                    icons.forEach((icon) => {
                        const rect = icon.getBoundingClientRect();
                        const center = rect.left + rect.width / 2;
                        const dist = Math.abs(e.clientX - center);
                        const influence = Math.max(0, 1 - dist / FALLOFF);
                        const scale = 1 + (MAX_SCALE - 1) * influence;
                        icon.style.transform = `scale(${scale.toFixed(3)}) translateY(${(-6 * influence).toFixed(1)}px)`;
                    });
                });
                dock.addEventListener('mouseleave', () => {
                    icons.forEach((icon) => { icon.style.transform = ''; });
                });
            });
        })();

        // Cursor-tilt: project thumbnails (.tilt-card) tilt toward the
        // pointer — the same 3D-perspective-on-hover pattern used by
        // Linear/Stripe/Vercel marketing sites. Desktop/tablet only
        // (needs a continuous pointer), capped to a small angle so it
        // reads as "alive", not gimmicky.
        (function setupCursorTilt() {
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            const MAX_TILT = 8; // degrees
            document.querySelectorAll('.tilt-card').forEach((card) => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const px = (e.clientX - rect.left) / rect.width - 0.5;
                    const py = (e.clientY - rect.top) / rect.height - 0.5;
                    card.style.transform = `perspective(600px) rotateY(${(px * MAX_TILT).toFixed(2)}deg) rotateX(${(-py * MAX_TILT).toFixed(2)}deg) scale(1.04)`;
                });
                card.addEventListener('mouseleave', () => { card.style.transform = ''; });
            });
        })();

        // Ambient desktop glow — follows the cursor across the canvas via
        // CSS custom properties, cheap (no layout thrash) and fades out
        // when the pointer leaves the canvas entirely.
        (function setupDesktopGlow() {
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            const wrap = document.getElementById('desktopStageWrap');
            const glow = document.getElementById('desktopGlow');
            if (!wrap || !glow) return;
            wrap.addEventListener('mousemove', (e) => {
                const rect = wrap.getBoundingClientRect();
                glow.style.setProperty('--gx', `${e.clientX - rect.left}px`);
                glow.style.setProperty('--gy', `${e.clientY - rect.top}px`);
                glow.classList.remove('opacity-0');
            });
            wrap.addEventListener('mouseleave', () => glow.classList.add('opacity-0'));
        })();

        // Magnetic nav links: pull toward the cursor within a small radius,
        // snap back on mouseleave — the "it wants to be clicked" feel used
        // on agency sites (Resend, Linear's own marketing nav).
        (function setupMagneticLinks() {
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            const STRENGTH = 0.35;
            document.querySelectorAll('.magnetic').forEach((el) => {
                el.style.transition = 'transform 300ms var(--ease-apple-soft)';
                el.addEventListener('mousemove', (e) => {
                    const rect = el.getBoundingClientRect();
                    const relX = e.clientX - (rect.left + rect.width / 2);
                    const relY = e.clientY - (rect.top + rect.height / 2);
                    el.style.transform = `translate(${relX * STRENGTH}px, ${relY * STRENGTH}px)`;
                });
                el.addEventListener('mouseleave', () => { el.style.transform = ''; });
            });
        })();

        // Mobile accordion: smooth GSAP height animation on native <details>,
        // replacing the browser's instant snap-open/closed. Still a real
        // <details>/<summary> element throughout (keyboard, screen readers,
        // "name" exclusive-group behavior all stay native) — JS only
        // intercepts the click to animate height, then syncs the `open`
        // attribute to match so native semantics never drift from what's
        // visually shown.
        (function setupAccordionMotion() {
            if (!window.gsap) return;
            const entries = document.querySelectorAll('.index-entry');
            if (!entries.length) return;
            const reduced = isReducedMotion();

            entries.forEach((details) => {
                const summary = details.querySelector('summary');
                const body = details.querySelector('.index-body');
                if (!summary || !body) return;
                let animating = false;

                summary.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (animating || reduced) {
                        details.open = !details.open;
                        return;
                    }
                    animating = true;

                    if (!details.open) {
                        // Opening: close any other entry in the same exclusive
                        // group first (native `name="work"` behavior), then
                        // expand this one from 0 to its natural height.
                        document.querySelectorAll('.index-entry[open]').forEach((other) => {
                            if (other !== details) other.querySelector('summary')?.click();
                        });
                        details.open = true;
                        const target = body.scrollHeight;
                        gsap.fromTo(body,
                            { height: 0, opacity: 0 },
                            { height: target, opacity: 1, duration: 0.45, ease: 'power3.out',
                              onComplete: () => { body.style.height = 'auto'; animating = false; } }
                        );
                    } else {
                        gsap.to(body, {
                            height: 0, opacity: 0, duration: 0.35, ease: 'power3.in',
                            onComplete: () => { details.open = false; body.style.height = ''; animating = false; }
                        });
                    }
                });
            });
        })();

        </script>

