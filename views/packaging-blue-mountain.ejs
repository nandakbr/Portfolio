<!DOCTYPE html>
<html class="scroll-smooth" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta property="og:title" content="Nanda Akbar | Blue Mountain" />
    <meta property="og:description" content="Packaging artwork for Blue Mountain." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nandakbrportfolio.netlify.app/packaging/blue-mountain" />
    <meta property="og:image" content="/assets/package2.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nanda Akbar | Blue Mountain" />
    <meta name="twitter:description" content="Packaging artwork for Blue Mountain." />
    <meta name="twitter:image" content="/assets/package2.webp" />
    <title>Nanda Akbar | Blue Mountain</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Tinos:ital@1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-background-light text-[#20211F]">
    <!-- Mobile only: single-artwork detail page, ported from Figma. Desktop keeps
         the existing draggable image-expand modal (openImageExpand) unchanged. -->
    <div class="md:hidden">
        <!-- Header -->
        <div class="px-6 pt-5 pb-3">
            <div class="flex items-center justify-between">
                <a href="/" class="text-sm font-bold tracking-tight focus-ring">Nanda Akbar</a>
                <p class="text-[0.6rem] uppercase tracking-[0.15em] opacity-50">PORTFOLIO / WORK</p>
            </div>
            <div class="border-t border-black/10 mt-3"></div>
        </div>

        <!-- Nav row: close + category tag -->
        <div class="px-6 pb-4 flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5 text-sm opacity-70 active:opacity-40 focus-ring" aria-label="Close">
                <span class="material-symbols-outlined text-base text-[#244BFF]">close</span>Close
            </a>
            <span class="text-[0.6rem] uppercase tracking-[0.1em] text-[#244BFF]">PACKAGING</span>
        </div>

        <!-- Title -->
        <div class="px-6 pb-6">
            <h1 class="text-3xl font-semibold leading-[1.05] tracking-tight">Blue<br>Mountain</h1>
        </div>

        <!-- Artwork: window-chrome, matches desktop/folder-window identity -->
        <div class="px-6">
            <div class="rounded-lg border border-black/10 shadow-sm overflow-hidden bg-surface-window">
                <div class="flex items-center gap-[9px] px-[11px] h-[27px] bg-surface-titlebar-alt border-b border-black/10">
                    <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                            <span class="w-2 h-2 rounded-full bg-surface-window border-[0.8px] border-ink-secondary"></span>
                    <span class="flex-1 text-center text-[0.65rem] opacity-50">Blue Mountain</span>
                </div>
                <div class="aspect-square bg-background-light">
                    <img alt="Blue Mountain packaging artwork" class="w-full h-full object-cover" src="/assets/package2.webp" loading="lazy" decoding="async">
                </div>
            </div>
        </div>

        <!-- Artwork view indicator + footer -->
        <div class="px-6 pt-6">
            <div class="flex items-center justify-between">
                <p class="text-[0.6rem] uppercase tracking-[0.1em] opacity-50">ARTWORK VIEW</p>
                <p class="text-[0.6rem] text-[#244BFF]">01 / 01</p>
            </div>
            <div class="border-t border-black/10 mt-4 pt-4 pb-10 flex items-center justify-between">
                <p class="text-[0.6rem] opacity-30">© 2026 Nanda Akbar</p>
                <a href="/" class="text-[0.6rem] uppercase tracking-[0.1em] text-[#244BFF] focus-ring">SELECTED WORK</a>
            </div>
        </div>
    </div>

    <!-- Desktop/tablet: this route is never visited directly — the packaging folder
         window on the homepage opens images via the draggable openImageExpand modal.
         This fallback just sends desktop visitors who land here directly back home. -->
    <div class="hidden md:flex min-h-screen items-center justify-center px-6">
        <div class="text-center">
            <p class="text-sm opacity-50 mb-4">This artwork opens as a window from the homepage.</p>
            <a href="/" class="text-sm underline underline-offset-4 focus-ring">← Back to homepage</a>
        </div>
    </div>
</body>

</html>
